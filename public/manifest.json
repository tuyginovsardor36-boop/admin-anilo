
{
  "lang": "uz-UZ",
  "name": "Anilo.uz - Professional Anime Portali",
  "short_name": "Anilo",
  "description": "Anilo.uz - O'zbekistondagi eng yirik professional anime portali. Sevimli animelaringizni yuqori sifatda (HD, 4K) va professional dublyajda tomosha qiling. PWA ilovasi orqali oflayn rejim va tezkor yuklanish imkoniyatidan foydalaning.",
  "id": "uz.anilo.mobile",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f97316",
  "theme_color": "#f97316",
  "orientation": "portrait",
  "scope": "/",
  "categories": [
    "entertainment",
    "video",
    "movies",
    "social"
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "auto",
  "edge_side_panel": {
    "preferred_width": 480
  },
  "share_target": {
    "action": "/?share=true",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+anilo",
      "url": "/?url=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/?file_open=true",
      "accept": {
        "text/plain": [".txt"],
        "application/json": [".json", ".anilo"]
      },
      "icons": [
        {
          "src": "/512.png",
          "sizes": "512x512",
          "type": "image/png",
          "purpose": "any maskable"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Sevimli",
      "url": "/?tab=favorites",
      "description": "Sevimli animelaringiz ro'yxati",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Jonli Efir",
      "url": "/?tab=live",
      "description": "Jonli efirlarni tomosha qiling",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "https://picsum.photos/seed/anilo1/1080/1920",
      "sizes": "1080x1920",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Anilo Mobile View"
    },
    {
      "src": "https://picsum.photos/seed/anilo2/1920/1080",
      "sizes": "1920x1080",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Anilo Desktop View"
    }
  ]
}
